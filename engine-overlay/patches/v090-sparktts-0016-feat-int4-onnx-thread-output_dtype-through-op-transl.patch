From 1c49b473f9a9e9fd28eee174bb6dc53e9a935905 Mon Sep 17 00:00:00 2001
From: suharvest <suharvest@gmail.com>
Date: Thu, 25 Jun 2026 14:32:32 +0800
Subject: [PATCH 16/38] feat(int4-onnx): thread output_dtype through
 op/translation/schema

int4_groupwise_gemm custom op gains output_dtype='float16'|'bfloat16' (default
float16 -> preserve input dtype, byte-identical). ONNX export dispatches to an
FP16-output translation (no output_dtype attr emitted) or a BF16-output
variant that sets output_dtype=kBF16(5) on the plugin node. Schema splits the
output into a separate TOut type constraint (FP16 in, FP16|BF16 out) and adds
the optional output_dtype attribute.

Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_013XsZpWRubKjuZDyZqx3q4E

diff --git a/tensorrt_edgellm/models/ops.py b/tensorrt_edgellm/models/ops.py
index 9aef07d..ecd9094 100644
--- a/tensorrt_edgellm/models/ops.py
+++ b/tensorrt_edgellm/models/ops.py
@@ -478,6 +478,18 @@ def _(weight, weight_scale, block_size):
 # ---------------------------------------------------------------------------
 
 
+def _int4_gemm_out_dtype(hidden_states: torch.Tensor,
+                         output_dtype: str) -> torch.dtype:
+    """Resolve the GEMM output torch dtype.
+
+    Default ``"float16"`` -> preserve the input dtype (legacy, byte-identical).
+    ``"bfloat16"`` -> opt-in BF16 output (overflow-safe down_proj path).
+    """
+    if output_dtype == "bfloat16":
+        return torch.bfloat16
+    return hidden_states.dtype
+
+
 @torch.library.custom_op("trt::int4_groupwise_gemm", mutates_args=())
 def int4_groupwise_gemm(
     hidden_states: torch.Tensor,  # [*, in_features] float16
@@ -486,21 +498,28 @@ def int4_groupwise_gemm(
     gemm_n: int,
     gemm_k: int,
     group_size: int,
+    output_dtype: str = "float16",
 ) -> torch.Tensor:
     """Stub: INT4 groupwise GEMM - returns zero tensor of correct shape."""
     *leading, _ = hidden_states.shape
     return torch.zeros(*leading,
                        gemm_n,
-                       dtype=hidden_states.dtype,
+                       dtype=_int4_gemm_out_dtype(hidden_states, output_dtype),
                        device=hidden_states.device)
 
 
 @int4_groupwise_gemm.register_fake
-def _(hidden_states, qweight, scales, gemm_n, gemm_k, group_size):
+def _(hidden_states,
+      qweight,
+      scales,
+      gemm_n,
+      gemm_k,
+      group_size,
+      output_dtype: str = "float16"):
     *leading, _ = hidden_states.shape
     return torch.empty(*leading,
                        gemm_n,
-                       dtype=hidden_states.dtype,
+                       dtype=_int4_gemm_out_dtype(hidden_states, output_dtype),
                        device=hidden_states.device)
 
 
diff --git a/tensorrt_edgellm/onnx/dynamo_translations.py b/tensorrt_edgellm/onnx/dynamo_translations.py
index a5b0104..1476109 100644
--- a/tensorrt_edgellm/onnx/dynamo_translations.py
+++ b/tensorrt_edgellm/onnx/dynamo_translations.py
@@ -254,6 +254,8 @@ def _int4_groupwise_gemm_translation(
     gemm_k: int,
     group_size: int,
 ) -> onnxscript.FLOAT16:
+    # Legacy FP16-output path. output_dtype attribute is omitted so the engine
+    # stays byte-identical to pre-mixed-precision graphs.
     return _trt_edgellm.Int4GroupwiseGemmPlugin(
         hidden_states,
         qweight,
@@ -264,6 +266,49 @@ def _int4_groupwise_gemm_translation(
     )
 
 
+# nvinfer1::DataType::kBF16 == 5 (TensorRT enum). The plugin reads this int32
+# attribute and routes to the FP32-accumulate / BF16-store kernels.
+_TRT_DATATYPE_BF16 = 5
+
+
+@script()
+def _int4_groupwise_gemm_bf16_translation(
+    hidden_states: onnxscript.FLOAT16,
+    qweight: onnxscript.INT8,
+    scales: onnxscript.FLOAT16,
+    gemm_n: int,
+    gemm_k: int,
+    group_size: int,
+) -> onnxscript.BFLOAT16:
+    # Opt-in BF16-output path: FP16 activation in, BF16 out (overflow-safe).
+    return _trt_edgellm.Int4GroupwiseGemmPlugin(
+        hidden_states,
+        qweight,
+        scales,
+        gemm_n=gemm_n,
+        gemm_k=gemm_k,
+        group_size=group_size,
+        output_dtype=_TRT_DATATYPE_BF16,
+    )
+
+
+def _int4_groupwise_gemm_dispatch(
+    hidden_states,
+    qweight,
+    scales,
+    gemm_n,
+    gemm_k,
+    group_size,
+    output_dtype: str = "float16",
+):
+    if output_dtype == "bfloat16":
+        return _int4_groupwise_gemm_bf16_translation(hidden_states, qweight,
+                                                     scales, gemm_n, gemm_k,
+                                                     group_size)
+    return _int4_groupwise_gemm_translation(hidden_states, qweight, scales,
+                                            gemm_n, gemm_k, group_size)
+
+
 # ---------------------------------------------------------------------------
 # INT8 SmoothQuant ops
 # ---------------------------------------------------------------------------
@@ -907,7 +952,7 @@ def build_custom_translation_table() -> dict:
         torch.ops.trt.mxfp8_weight_dq.default:
         _mxfp8_weight_dq_translation,
         torch.ops.trt.int4_groupwise_gemm.default:
-        _int4_groupwise_gemm_translation,
+        _int4_groupwise_gemm_dispatch,
         torch.ops.trt.int8_sq_act_qdq.default:
         _int8_sq_act_qdq_translation,
         torch.ops.trt.int8_sq_weight_dq.default:
diff --git a/tensorrt_edgellm/onnx/onnx_custom_schemas.py b/tensorrt_edgellm/onnx/onnx_custom_schemas.py
index eaaa7b6..d37a788 100644
--- a/tensorrt_edgellm/onnx/onnx_custom_schemas.py
+++ b/tensorrt_edgellm/onnx/onnx_custom_schemas.py
@@ -520,14 +520,19 @@ _int4_groupwise_gemm_schema = OpSchema(
         OpSchema.FormalParameter(
             name="output",
             description="Output tensor",
-            type_str="T",
+            type_str="TOut",
         ),
     ],
     type_constraints=[
         (
             "T",
             ["tensor(float)", "tensor(float16)", "tensor(bfloat16)"],
-            "Input and output data type.",
+            "Input data type.",
+        ),
+        (
+            "TOut",
+            ["tensor(float)", "tensor(float16)", "tensor(bfloat16)"],
+            "Output data type (FP16 default, opt-in BF16).",
         ),
     ],
     attributes=[
@@ -549,6 +554,13 @@ _int4_groupwise_gemm_schema = OpSchema(
             description="Group size",
             required=True,
         ),
+        OpSchema.Attribute(
+            name="output_dtype",
+            type=OpSchema.AttrType.INT,
+            description=("Optional output dtype as nvinfer1::DataType enum int "
+                         "(kHALF default when absent, kBF16=5 opt-in)."),
+            required=False,
+        ),
     ],
 )
 
