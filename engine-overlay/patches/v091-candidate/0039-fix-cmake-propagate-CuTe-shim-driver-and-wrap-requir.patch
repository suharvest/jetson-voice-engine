From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Codex Validation <codex@local.invalid>
Date: Fri, 24 Jul 2026 17:15:36 +0800
Subject: [PATCH] fix(cmake): propagate CUDA driver through static CuTe users

Upstream PR #118 now propagates both the CuTe shim and the CUDA 12.x wrap
link option. Retain only the CUDA driver PUBLIC propagation until the
final-link A/B gate proves it can also be retired.
---
 cmake/CuteDsl.cmake | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/cmake/CuteDsl.cmake b/cmake/CuteDsl.cmake
--- a/cmake/CuteDsl.cmake
+++ b/cmake/CuteDsl.cmake
@@ -1049,6 +1049,10 @@ function(cute_dsl_setup)
     endif()
     if(CUDA_DRIVER_LIB AND NOT CUDA_DRIVER_LIB MATCHES "-NOTFOUND$")
-      target_link_libraries(${_tgt} PRIVATE "${CUDA_DRIVER_LIB}")
+      if(_tgt_type STREQUAL "STATIC_LIBRARY")
+        target_link_libraries(${_tgt} PUBLIC "${CUDA_DRIVER_LIB}")
+      else()
+        target_link_libraries(${_tgt} PRIVATE "${CUDA_DRIVER_LIB}")
+      endif()
     endif()
     # CUDA 12.0–12.6: wrap _cudaLaunchKernelEx (cudaKernel_t → CUfunction, e.g.
     # JetPack 6). CUDA 11.x artifacts use CUmodule ABI instead.
