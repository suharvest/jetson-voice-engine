From cdebbe95b7a08acb7742719a9912195ec5be68ad Mon Sep 17 00:00:00 2001
From: suharvest <suharvest@gmail.com>
Date: Thu, 25 Jun 2026 08:12:05 +0800
Subject: [PATCH 06/40] feat(config): add opt-in mixed_precision (BF16 residual
 / FP16 attention)

Add a `mixed_precision` ModelConfig flag (default False) plus derived
`mixed_precision_active`, `residual_dtype` and `attention_dtype`
properties. When enabled for an unquantized backbone, the residual
stream / RMSNorm / MLP / embedding / lm_head run in BF16 while the
attention island (q/k/v/o_proj, RoPE, SDPA, KV cache) stays FP16, with
Cast nodes at the boundary. This removes FP16 overflow on the residual
path for models whose activations exceed the FP16 range.

Default behaviour is unchanged: with the flag unset every linear is
FP16 and the residual dtype is FP16, exactly as before. The flag is
ignored when the backbone is quantized (FP8/NVFP4/AWQ/...), which keep
their own dtype contract.

Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
---
 tensorrt_edgellm/config.py | 21 +++++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/tensorrt_edgellm/config.py b/tensorrt_edgellm/config.py
index f16d4e9..94d86ba 100644
--- a/tensorrt_edgellm/config.py
+++ b/tensorrt_edgellm/config.py
@@ -526,6 +526,9 @@ class ModelConfig:
     final_logit_softcapping: Optional[float] = None
     # Weight dtype in the checkpoint
     torch_dtype: str = "bfloat16"
+    # Opt-in BF16 residual/MLP path with FP16 attention. Quantized backbones
+    # keep their existing dtype contract unless explicitly enabled later.
+    mixed_precision: bool = False
     # When True, embed_tokens and lm_head share the same weight tensor
     tie_word_embeddings: bool = False
     # Sliding window attention size; -1 means no sliding window.
@@ -774,6 +777,23 @@ class ModelConfig:
         }
         return _MAP.get(self.torch_dtype, torch.bfloat16)
 
+    @property
+    def mixed_precision_active(self) -> bool:
+        """Whether the unquantized BF16-residual/FP16-attention path is active."""
+        return bool(self.mixed_precision) and not self.quant.is_quantized
+
+    @property
+    def residual_dtype(self) -> "torch.dtype":  # noqa: F821
+        """Dtype for the residual stream, RMSNorm, MLP, embedding and head."""
+        import torch
+        return torch.bfloat16 if self.mixed_precision_active else torch.float16
+
+    @property
+    def attention_dtype(self) -> "torch.dtype":  # noqa: F821
+        """Dtype for attention projections, RoPE, SDPA and KV cache."""
+        import torch
+        return torch.float16
+
     def for_rank(self, rank: int, world: int) -> "ModelConfig":
         """Return a per-rank copy of this config for TP.
 
@@ -960,6 +980,7 @@ class ModelConfig:
                                                  None),
             torch_dtype=llm_dict.get("torch_dtype",
                                      llm_dict.get("dtype", "bfloat16")),
+            mixed_precision=bool(llm_dict.get("mixed_precision", False)),
             tie_word_embeddings=llm_dict.get("tie_word_embeddings", False),
             sliding_window_size=sliding_window_size,
