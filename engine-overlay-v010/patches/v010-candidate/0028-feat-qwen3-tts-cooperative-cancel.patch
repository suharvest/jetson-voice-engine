         }
     }
 
@@ -2501,6 +2507,18 @@ bool Qwen3OmniTTSRuntime::runTalkerGenerationLoop(std::vector<PerBatchTalkerStat
 
                 states[b].talkerFrames++;
 
+                // Cooperative cancel is polled once per decoded frame after
+                // sampling and before EOS/max-length handling. Finish only the
+                // cancelled batch; other requests in the same batch continue.
+                if (b < static_cast<int32_t>(streamingHandlers.size()) && streamingHandlers[b].shouldCancel
+                    && streamingHandlers[b].shouldCancel())
+                {
+                    states[b].finished = true;
+                    unfinished--;
+                    emitters[b].flushFinal();
+                    continue;
+                }
+
                 if (states[b].codecToken == codecEosId || states[b].talkerFrames >= maxFrames)
                 {
                     states[b].finished = true;
