+bool Qwen3OmniTTSRuntime::setVoiceCloneEmbedding(std::vector<float> const& embedding, cudaStream_t stream)
+{
+    constexpr int32_t kEmbeddingDim = talker_constants::kLegacyVoiceCloneEmbeddingDim;
+    if (static_cast<int32_t>(embedding.size()) != kEmbeddingDim)
+    {
+        LOG_ERROR("speaker embedding must contain exactly %d float32 values, got %zu", kEmbeddingDim,
+            embedding.size());
+        return false;
+    }
+    if (mVoiceCloneXVector.getShape().getNumDims() != 1 || mVoiceCloneXVector.getShape()[0] != kEmbeddingDim)
+    {
+        LOG_ERROR("speaker embedding conditioning slot has unexpected shape; expected [%d]", kEmbeddingDim);
+        return false;
+    }
+
+    std::vector<__half> halfEmbedding(static_cast<size_t>(kEmbeddingDim));
+    for (int32_t i = 0; i < kEmbeddingDim; ++i)
+    {
+        float const value = embedding[static_cast<size_t>(i)];
+        if (!std::isfinite(value))
+        {
+            LOG_ERROR("speaker embedding contains non-finite float32 at index %d", i);
+            return false;
+        }
+        halfEmbedding[static_cast<size_t>(i)] = __float2half_rn(value);
+        if (!std::isfinite(__half2float(halfEmbedding[static_cast<size_t>(i)])))
+        {
+            LOG_ERROR("speaker embedding value at index %d overflows FP16 conditioning", i);
+            return false;
+        }
+    }
+
+    CUDA_CHECK(cudaMemcpyAsync(mVoiceCloneXVector.rawPointer(), halfEmbedding.data(),
+        halfEmbedding.size() * sizeof(__half), cudaMemcpyHostToDevice, stream));
+    return true;
+}
