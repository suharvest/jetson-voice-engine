+bool validateVoiceCloneRequest(Qwen3OmniTTSRuntime::TalkerGenerationRequest const& request, char const* context)
+{
+    bool const hasEmbedding = !request.speakerEmbedding.empty();
+    bool const hasRefAudio = !request.refAudioPath.empty();
+    bool const hasRefText = !request.refText.empty();
+    bool const hasSpeaker = request.speakerId >= 0 || !request.speakerName.empty();
+
+    if ((hasEmbedding || hasRefAudio) && hasSpeaker)
+    {
+        LOG_ERROR("%s: speaker/speaker_id is mutually exclusive with speaker_embedding_b64/ref_audio", context);
+        return false;
+    }
+    if (hasEmbedding && hasRefAudio)
+    {
+        LOG_ERROR("%s: speaker_embedding_b64 and ref_audio are mutually exclusive", context);
+        return false;
+    }
+    if (hasEmbedding && hasRefText)
+    {
+        LOG_ERROR("%s: precomputed speaker embedding cannot be combined with ref_text", context);
+        return false;
+    }
+    if (hasRefText && !hasRefAudio)
+    {
+        LOG_ERROR("%s: ref_text requires ref_audio", context);
+        return false;
+    }
+    return true;
+}
