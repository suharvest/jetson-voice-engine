+constexpr size_t kLegacySpeakerEmbeddingDim = 1024;
+constexpr size_t kLegacySpeakerEmbeddingBytes = kLegacySpeakerEmbeddingDim * sizeof(float);
+
+int decodeBase64Value(char value)
+{
+    if (value >= 'A' && value <= 'Z')
+        return value - 'A';
+    if (value >= 'a' && value <= 'z')
+        return value - 'a' + 26;
+    if (value >= '0' && value <= '9')
+        return value - '0' + 52;
+    if (value == '+')
+        return 62;
+    if (value == '/')
+        return 63;
+    return -1;
+}
+
+std::vector<float> decodeSpeakerEmbeddingB64(std::string const& encoded)
+{
+    if (encoded.empty())
+    {
+        throw std::invalid_argument("speaker_embedding_b64 must not be empty");
+    }
+    if (encoded.size() % 4 != 0)
+    {
+        throw std::invalid_argument("speaker_embedding_b64 length must be a multiple of 4");
+    }
+
+    size_t padding = 0;
+    if (!encoded.empty() && encoded.back() == '=')
+        ++padding;
+    if (encoded.size() > 1 && encoded[encoded.size() - 2] == '=')
+        ++padding;
+    if (padding > 2)
+    {
+        throw std::invalid_argument("speaker_embedding_b64 has invalid padding");
+    }
+
+    std::vector<uint8_t> bytes;
+    bytes.reserve(encoded.size() / 4 * 3 - padding);
+    for (size_t offset = 0; offset < encoded.size(); offset += 4)
+    {
+        bool const isFinal = offset + 4 == encoded.size();
+        char const c0 = encoded[offset];
+        char const c1 = encoded[offset + 1];
+        char const c2 = encoded[offset + 2];
+        char const c3 = encoded[offset + 3];
+        int const v0 = decodeBase64Value(c0);
+        int const v1 = decodeBase64Value(c1);
+        bool const pad2 = c2 == '=';
+        bool const pad3 = c3 == '=';
+        int const v2 = pad2 ? 0 : decodeBase64Value(c2);
+        int const v3 = pad3 ? 0 : decodeBase64Value(c3);
+
+        if (v0 < 0 || v1 < 0 || v2 < 0 || v3 < 0 || (pad2 && !pad3) || (!isFinal && (pad2 || pad3)))
+        {
+            throw std::invalid_argument("speaker_embedding_b64 contains invalid characters or padding");
+        }
+        // Reject non-canonical encodings instead of silently accepting bytes
+        // hidden in the unused bits of a padded quartet.
+        if ((pad2 && (v1 & 0x0f) != 0) || (pad3 && !pad2 && (v2 & 0x03) != 0))
+        {
+            throw std::invalid_argument("speaker_embedding_b64 has non-zero trailing bits");
+        }
+
+        bytes.push_back(static_cast<uint8_t>((v0 << 2) | (v1 >> 4)));
+        if (!pad2)
+        {
+            bytes.push_back(static_cast<uint8_t>((v1 << 4) | (v2 >> 2)));
+        }
+        if (!pad3)
+        {
+            bytes.push_back(static_cast<uint8_t>((v2 << 6) | v3));
+        }
+    }
+
+    if (bytes.size() != kLegacySpeakerEmbeddingBytes)
+    {
+        throw std::invalid_argument(
+            "speaker_embedding_b64 must decode to exactly 4096 bytes (little-endian float32[1024])");
+    }
+
+    static_assert(sizeof(float) == sizeof(uint32_t));
+    std::vector<float> embedding(kLegacySpeakerEmbeddingDim);
+    for (size_t i = 0; i < kLegacySpeakerEmbeddingDim; ++i)
+    {
+        size_t const base = i * sizeof(float);
+        uint32_t const bits = static_cast<uint32_t>(bytes[base])
+            | (static_cast<uint32_t>(bytes[base + 1]) << 8)
+            | (static_cast<uint32_t>(bytes[base + 2]) << 16)
+            | (static_cast<uint32_t>(bytes[base + 3]) << 24);
+        std::memcpy(&embedding[i], &bits, sizeof(float));
+        if (!std::isfinite(embedding[i]))
+        {
+            throw std::invalid_argument("speaker_embedding_b64 contains NaN or infinity");
+        }
+    }
+    return embedding;
+}
