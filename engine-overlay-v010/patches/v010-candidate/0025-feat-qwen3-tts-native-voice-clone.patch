 examples/omni/qwen3_tts_streaming_worker.cpp                    | 65 ++++++++++++--------
 .../qwen3_tts/modeling_qwen3_tts_clone_encoders.py             |  4 +++-
 .../qwen3_tts/modeling_qwen3_tts_code2wav.py                   |  4 +++-
 4 files changed, 72 insertions(+), 29 deletions(-)

diff --git a/examples/omni/qwen3_tts_inference.cpp b/examples/omni/qwen3_tts_inference.cpp
index f535b08..752e552 100644
--- a/examples/omni/qwen3_tts_inference.cpp
+++ b/examples/omni/qwen3_tts_inference.cpp
@@ -487,7 +487,10 @@ int main(int argc, char** argv)
     // handleAudioGeneration call; cleared between groups.
     struct StreamingBatchCtx
     {
-        std::vector<__half> pcmBuffer; //!< Accumulated FP16 PCM samples (chunk-by-chunk concat)
+        // Normalize each chunk to FP32. Qwen3-Omni Code2Wav emits FP16, while
+        // Qwen3-TTS tokenizer_decoder emits FP32; treating both as __half
+        // reinterprets FP32 bytes and produces saturated/noisy WAV output.
+        std::vector<float> pcmBuffer;
         int32_t numFramesEmitted{0};   //!< Codec frames vocoded so far
         int32_t numChunkCalls{0};      //!< Total callback invocations (including final flush)
         bool finalSeen{false};
@@ -574,9 +577,28 @@ int main(int argc, char** argv)
                         }
                         else if (chunkAudio.waveform && !chunkAudio.waveform->isEmpty())
                         {
-                            __half const* src = static_cast<__half const*>(chunkAudio.waveform->rawPointer());
                             int64_t const samples = chunkAudio.waveform->getShape()[1];
-                            ctx.pcmBuffer.insert(ctx.pcmBuffer.end(), src, src + samples);
+                            auto const dtype = chunkAudio.waveform->getDataType();
+                            ctx.pcmBuffer.reserve(ctx.pcmBuffer.size() + static_cast<size_t>(samples));
+                            if (dtype == nvinfer1::DataType::kFLOAT)
+                            {
+                                float const* src = static_cast<float const*>(chunkAudio.waveform->rawPointer());
+                                ctx.pcmBuffer.insert(ctx.pcmBuffer.end(), src, src + samples);
+                            }
+                            else if (dtype == nvinfer1::DataType::kHALF)
+                            {
+                                __half const* src = static_cast<__half const*>(chunkAudio.waveform->rawPointer());
+                                for (int64_t i = 0; i < samples; ++i)
+                                {
+                                    ctx.pcmBuffer.push_back(__half2float(src[i]));
+                                }
+                            }
+                            else
+                            {
+                                LOG_WARNING("Streaming vocode returned unsupported waveform dtype for request %zu",
+                                    requestIdx);
+                                ctx.vocoderFailed = true;
+                            }
                             if (!ctx.ttfpaRecorded && ctx.ttfpaEvent)
                             {
                                 CUDA_CHECK(cudaEventRecord(ctx.ttfpaEvent, stream));
@@ -627,8 +649,8 @@ int main(int argc, char** argv)
                 {
                     int64_t const totalSamples = static_cast<int64_t>(ctx.pcmBuffer.size());
                     auto waveformTensor = std::make_shared<rt::Tensor>(
-                        rt::Coords{1, totalSamples}, rt::DeviceType::kCPU, nvinfer1::DataType::kHALF, "streaming_pcm");
-                    std::memcpy(waveformTensor->rawPointer(), ctx.pcmBuffer.data(), totalSamples * sizeof(__half));
+                        rt::Coords{1, totalSamples}, rt::DeviceType::kCPU, nvinfer1::DataType::kFLOAT, "streaming_pcm");
+                    std::memcpy(waveformTensor->rawPointer(), ctx.pcmBuffer.data(), totalSamples * sizeof(float));
                     audioOutput.waveform = waveformTensor;
                     audioOutput.sampleRate = code2wavRunner->getConfig().sampleRate;
                     audioOutput.hasWaveform = true;

