+rt::OptionalInputTensor Qwen3OmniTTSRuntime::scalesFor(rt::Tensor const& table) const
+{
+    // Only the standalone text table is allowed to use the local FP8 sidecar.
+    // Keying on dtype also works for the short-lived views used by the streaming
+    // path, while all normal FP16/codec tables retain std::nullopt.
+    if (mTextEmbeddingIsFp8 && table.getDataType() == nvinfer1::DataType::kFP8)
+    {
+        return std::cref(mTextEmbeddingScales);
+    }
+    return std::nullopt;
+}
