@@ -0,0 +1,57 @@
+#!/usr/bin/env python3
+"""Quantize a standalone Qwen3-TTS text embedding table to FP8 E4M3.
+
+The v0.10 generic ``--fp8-embedding`` option targets LLM thinker
+``embedding.safetensors``. Qwen3-TTS keeps its table in
+``text_embedding.safetensors`` and is exported through a separate component
+path, so this small utility writes the same two-dtype sidecar consumed by the
+native TTS runtime: an FP8 table and FP32 per-row block scales.
+
+Usage::
+
+    python scripts/quantize_text_embedding_fp8.py input.safetensors output.safetensors
+"""
+
+from __future__ import annotations
+
+import argparse
+
+import torch
+from safetensors.torch import load_file, save_file
+
+
+FP8_MAX = 448.0
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("input")
+    parser.add_argument("output")
+    parser.add_argument("--key", default="text_embedding")
+    parser.add_argument("--block", type=int, default=128)
+    args = parser.parse_args()
+
+    tensors = load_file(args.input)
+    key = args.key if args.key in tensors else next(iter(tensors))
+    weight = tensors[key].to(torch.float32)
+    if weight.ndim != 2:
+        raise ValueError(f"expected 2D text embedding table, got {tuple(weight.shape)}")
+    vocab, hidden = weight.shape
+    if args.block <= 0 or hidden % args.block:
+        raise ValueError(f"hidden size {hidden} must be divisible by block {args.block}")
+    if args.block % 16:
+        raise ValueError("block must be a multiple of 16 for the FP8 vectorized loader")
+
+    groups = hidden // args.block
+    grouped = weight.reshape(vocab, groups, args.block)
+    scales = grouped.abs().amax(dim=-1, keepdim=True).clamp(min=1e-8) / FP8_MAX
+    quantized = (grouped / scales).clamp(-FP8_MAX, FP8_MAX).to(torch.float8_e4m3fn)
+    table = quantized.reshape(vocab, hidden).contiguous()
+    scales = scales.reshape(vocab, groups).to(torch.float32).contiguous()
+
+    save_file({"text_embedding": table, "text_embedding_scales": scales}, args.output)
+    print(f"wrote {args.output}: table={tuple(table.shape)} scales={tuple(scales.shape)} block={args.block}")
+
+
+if __name__ == "__main__":
+    main()
