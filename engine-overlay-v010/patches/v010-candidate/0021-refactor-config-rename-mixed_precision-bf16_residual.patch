index 8a92df83f85ff5c159cf6f86a61ecedcbe0af44a..55213e58e0c9f4b8baa04f1ce2bc04eb479d2c18 100644
--- a/tests/test_mixed_precision_int4.py
+++ b/tests/test_bf16_residual_int4.py
@@ -6,7 +6,7 @@ Covers the opt-in dtype routing that lets an INT4-AWQ backbone coexist with the
 BF16-residual / FP16-attention mixed-precision graph, with the MLP down_proj
