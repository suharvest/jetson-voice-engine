From f0fbbb22fb3ece8509f08298b947e102eda817bb Mon Sep 17 00:00:00 2001
From: suharvest <suharvest@gmail.com>
Date: Thu, 25 Jun 2026 14:32:32 +0800
Subject: [PATCH] feat(linear): AWQLinear BF16-output bridge for
 mixed-precision MLP

AWQLinear gains opt-in output_bf16: accepts BF16 input (casts to FP16 at the
MLP-island boundary, mirroring the FP16 attention island) and requests BF16
GEMM output. make_linear sets output_bf16 only for .down_proj under
mixed_precision_active (the overflow-prone linear); gate/up stay FP16 for the
SwiGLU mul. Default path unchanged: FP16 input -> FP16 output, byte-identical.

Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_013XsZpWRubKjuZDyZqx3q4E

diff --git a/tensorrt_edgellm/models/linear.py b/tensorrt_edgellm/models/linear.py
index b9f6b87e871f8d838f67244729a70e1c87208821..cda23b329972afd19aa4a45481aa3aa09d5f38a0 100644
--- a/tensorrt_edgellm/models/linear.py
+++ b/tensorrt_edgellm/models/linear.py
@@ -69,6 +69,30 @@ def _int4_groupwise_gemm_dispatch(hidden_states, qweight, scales, gemm_n,
                                group_size)
 
 
+def _int4_groupwise_gemm_bf16(hidden_states, qweight, scales, gemm_n, gemm_k,
+                              group_size):
+    """Emit the legacy INT4 op's BF16-output variant.
+
+    The cuteDSL V2 plugin currently advertises FP16 output only, so the
+    overflow-safe BF16 path must be exported with plugin V1.  Refuse a
+    mismatched selector rather than silently pairing V2 fragment weights with
+    the legacy op.
+    """
+    if int4_gemm_plugin_version() != 1:
+        raise RuntimeError(
+            "BF16-output INT4 GEMM requires --int4-gemm-plugin-version 1; "
+            "Int4GroupwiseGemmPluginV2 currently supports FP16 output only")
+    return int4_groupwise_gemm(
+        hidden_states,
+        qweight,
+        scales,
+        gemm_n,
+        gemm_k,
+        group_size,
+        output_dtype="bfloat16",
+    )
+
+
 def _require_bf16_input(hidden_states: torch.Tensor, layer_name: str) -> None:
     if hidden_states.dtype != torch.bfloat16:
         raise TypeError(
@@ -537,11 +561,15 @@ class AWQLinear(LinearBase):
         out_features: int,
         group_size: int = 128,
         bias: bool = False,
+        output_bf16: bool = False,
     ) -> None:
         super().__init__()
         self.in_features = in_features
         self.out_features = out_features
         self.group_size = group_size
+        # Opt-in: emit BF16 output (overflow-safe down_proj path under
+        # mixed_precision_with_quant). Default False -> FP16, byte-identical.
+        self.output_bf16 = output_bf16
         # Initialized in AWQ layout [in, out//8] int32; loader repacks to
         # [out//2, in] int8 (swizzled plugin layout) before inference/export.
         self.register_buffer(
@@ -563,17 +591,33 @@ class AWQLinear(LinearBase):
             self.bias = None
 
     def forward(self, hidden_states: torch.Tensor) -> torch.Tensor:
-        _require_fp16_input(hidden_states, "AWQLinear")
-        out = _int4_groupwise_gemm_dispatch(
-            hidden_states,
-            self.qweight,
-            self.scales.to(torch.float16),
-            self.out_features,
-            self.in_features,
-            self.group_size,
-        )
+        # The INT4 kernel takes FP16 activation. Under the mixed-precision path
+        # the residual stream is BF16, so accept BF16 input and cast to FP16 at
+        # the MLP-island boundary (mirrors the FP16 attention island). When
+        # output_bf16 is set, the GEMM emits BF16 directly (down_proj), so the
+        # overflow-prone output never lands in FP16.
+        if hidden_states.dtype != torch.float16:
+            hidden_states = hidden_states.to(torch.float16)
+        if self.output_bf16:
+            out = _int4_groupwise_gemm_bf16(
+                hidden_states,
+                self.qweight,
+                self.scales.to(torch.float16),
+                self.out_features,
+                self.in_features,
+                self.group_size,
+            )
+        else:
+            out = _int4_groupwise_gemm_dispatch(
+                hidden_states,
+                self.qweight,
+                self.scales.to(torch.float16),
+                self.out_features,
+                self.in_features,
+                self.group_size,
+            )
         if self.bias is not None:
-            out = out + self.bias
+            out = out + self.bias.to(out.dtype)
         return out
 
 
@@ -916,8 +960,18 @@ def make_linear(
         layer = MXFP8Linear(in_features, out_features, config.quant.group_size,
                             bias)
     elif quant_type == QUANT_INT4_AWQ:
-        layer = AWQLinear(in_features, out_features, config.quant.group_size,
-                          bias)
+        # Under the mixed-precision+quant path the residual stream is BF16; the
+        # MLP down_proj is the overflow-prone linear, so emit BF16 output for it
+        # (gate/up stay FP16 for the SwiGLU mul). Attention projections are
+        # excluded by construction (they are FP16 unquantized here).
+        output_bf16 = (config.mixed_precision_active
+                       and module_name.endswith(".down_proj")
+                       and not _is_attention_projection(module_name))
+        layer = AWQLinear(in_features,
+                          out_features,
+                          config.quant.group_size,
+                          bias,
+                          output_bf16=output_bf16)
     elif quant_type == QUANT_INT4_AWQ_MODELOPT:
         layer = ModelOptAWQPrepackedLinear(in_features, out_features,
                                            config.quant.group_size, bias)
