     EngineExecutor(std::filesystem::path const& enginePath, TensorRegistry registry);
 
+    //! Construct an executor with a fresh context over a non-owned engine.
+    EngineExecutor(nvinfer1::ICudaEngine* borrowedEngine, TensorRegistry registry);
+
+    nvinfer1::ICudaEngine* enginePtr() const noexcept
+    {
+        return mEngine ? mEngine.get() : mBorrowedEngine;
+    }
