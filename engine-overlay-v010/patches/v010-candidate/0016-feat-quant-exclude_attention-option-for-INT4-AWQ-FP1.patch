From 61eb44dbb4229eb76f0b964e34c5f7068b95fa85 Mon Sep 17 00:00:00 2001
From: suharvest <suharvest@gmail.com>
Date: Thu, 25 Jun 2026 14:36:54 +0800
Subject: [PATCH] feat(quant): exclude_attention option for INT4-AWQ (FP16
 attention island)

build_quant_config / quantize_and_export / quantize CLI gain --exclude_attention
which disables INT4 quantizers on q/k/v/o_proj, keeping attention FP16 while the
MLP is INT4. Required for the mixed-precision overflow-safe recipe (attention
FP16 island + INT4 MLP with BF16 down_proj output). Default False -> unchanged.

Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_013XsZpWRubKjuZDyZqx3q4E

diff --git a/tensorrt_edgellm/quantization/quantization_configs.py b/tensorrt_edgellm/quantization/quantization_configs.py
index 3455bb0746c90125555ccba5a91466bc2c7b59a1..021a13b9434aa6f019b6387e6b6f34fd64f74897 100644
--- a/tensorrt_edgellm/quantization/quantization_configs.py
+++ b/tensorrt_edgellm/quantization/quantization_configs.py
@@ -67,6 +67,16 @@ _AUDIO_PREFIXES = (
 )
 _AUDIO_PATTERNS = tuple(f"*{p}.*" for p in _AUDIO_PREFIXES)
 
+# Keep the attention projection island unquantized for the SparkTTS
+# BF16-residual/FP16-attention W4A16 path.
+_ATTENTION_PROJ_PATTERNS = (
+    "*q_proj*",
+    "*k_proj*",
+    "*v_proj*",
+    "*o_proj*",
+)
+
+
 # Qwen3-Omni Talker CodePredictor.
 _CP_PREFIXES = ("code_predictor", )
 _CP_PATTERNS = tuple(f"*{p}.*" for p in _CP_PREFIXES)
@@ -175,6 +185,7 @@ def build_quant_config(
     visual_quantization: Optional[str] = None,
     audio_quantization: Optional[str] = None,
     cp_quantization: Optional[str] = None,
+    exclude_attention: bool = False,
 ) -> Dict[str, Any]:
     """Build a composite ModelOpt quantization config from method names.
 
@@ -247,6 +258,8 @@ def build_quant_config(
         disable_patterns += _VISUAL_PATTERNS
     if audio_quantization is None:
         disable_patterns += _AUDIO_PATTERNS
+    if exclude_attention:
+        disable_patterns += list(_ATTENTION_PROJ_PATTERNS)
     entries += _disable_entries(disable_patterns)
 
     # Re-enable opted-in modalities at the requested precision (after the
diff --git a/tensorrt_edgellm/quantization/quantize.py b/tensorrt_edgellm/quantization/quantize.py
